<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo || "Acutis IVC" %>
    </title>

    <link rel="stylesheet" href="/css/1.0-Catequista_Materiais.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap"
        rel="stylesheet">

</head>

<body>

    <div class="layout">

        <aside class="sidebar">

            <div class="logo">

                <img src="/logo.jpg" alt="Acutis IVC">

                <h2>Acutis IVC</h2>

                <span>Diocese de Bagé</span>

            </div>

            <nav>

                <a href="/catequistaInicial">

                    <i class="fa-solid fa-house"></i>

                    <span>Início</span>

                </a>

                <a href="/planejamento">

                    <i class="fa-solid fa-calendar-days"></i>

                    <span>Planejamento</span>

                </a>

                <a href="/catequizandos">

                    <i class="fa-solid fa-clipboard-check"></i>

                    <span>Frequência</span>

                </a>

                <a class="ativo" href="/materiais">

                    <i class="fa-solid fa-folder-open"></i>

                    <span>Materiais</span>

                </a>

                <a href="/grupos">

                    <i class="fa-solid fa-users"></i>

                    <span>Grupos</span>

                </a>

            </nav>

        </aside>

        <main class="principal">

            <header class="banner">

                <img src="/topo.png" class="banner-img" alt="Banner">

            </header>