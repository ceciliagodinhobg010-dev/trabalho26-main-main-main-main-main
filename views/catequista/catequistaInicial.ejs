            <div class="footer-bottom">
                <span>© 2026 Acutis IVC. Todos os direitos reservados.</span>
                <span>“Não eu, mas Deus.”</span>
            </div>

        </footer>

        <button class="back-to-top" id="backToTop" type="button"
            aria-label="Voltar ao topo">
            ↑
        </button>

    </main>

