<%- include("../cabecalho2", { titulo: "Acutis IVC | Editar Grupo" }) %>

<section class="cabecalho">


<div class="titulo">

    <h1>
        Editar Grupo
    </h1>

    <p>
        Atualize as informações do grupo de catequese.
    </p>

</div>


</section>

<section class="painel">


<div class="painel-header">

    <div>

        <h2>
            <i class="fa-solid fa-pen-to-square"></i>
            Editar grupo
        </h2>

        <p>
            Altere os dados necessários.
        </p>

    </div>

</div>

<form
    action="/grupos/edt/<%= grupo._id %>"
    method="POST"
    class="formulario"
>

    <div class="campo">

        <label for="nome">
            Nome do grupo
        </label>

        <input
            type="text"
            id="nome"
            name="nome"
            value="<%= grupo.nome %>"
            required
        >

    </div>

    <div class="campo">

        <label for="ano">
            Ano
        </label>

        <input
            type="number"
            id="ano"
            name="ano"
            value="<%= grupo.ano %>"
            required
        >

    </div>

    <div class="campo">

        <label for="dia">
            Dia da semana dos encontros
        </label>

        <select
            id="dia"
            name="dia"
            required
        >

            <option value="Segunda-feira" <%= grupo.dia === "Segunda-feira" ? "selected" : "" %>>
                Segunda-feira
            </option>

            <option value="Terça-feira" <%= grupo.dia === "Terça-feira" ? "selected" : "" %>>
                Terça-feira
            </option>

            <option value="Quarta-feira" <%= grupo.dia === "Quarta-feira" ? "selected" : "" %>>
                Quarta-feira
            </option>

            <option value="Quinta-feira" <%= grupo.dia === "Quinta-feira" ? "selected" : "" %>>
                Quinta-feira
            </option>

            <option value="Sexta-feira" <%= grupo.dia === "Sexta-feira" ? "selected" : "" %>>
                Sexta-feira
            </option>

            <option value="Sábado" <%= grupo.dia === "Sábado" ? "selected" : "" %>>
                Sábado
            </option>

            <option value="Domingo" <%= grupo.dia === "Domingo" ? "selected" : "" %>>
                Domingo
            </option>

        </select>

    </div>

    <div class="campo">

        <label for="primeiroEncontro">
            Data do primeiro encontro
        </label>

        <input
            type="date"
            id="primeiroEncontro"
            name="primeiroEncontro"
            value="<%= grupo.primeiroEncontro %>"
            required
        >

    </div>

    <div class="acoes-formulario">

        <a href="/grupos/lst" class="btn secundario">
            Cancelar
        </a>

        <button
            type="submit"
            class="btn principal"
        >

            <i class="fa-solid fa-save"></i>

            Atualizar grupo

        </button>

    </div>

</form>


</section>

<%- include("../rodape.ejs") %>
